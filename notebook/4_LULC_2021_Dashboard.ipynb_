{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyO4ZrDW2KEHQk9Zrnbgds87"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":1,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"FVsRAZt6efy7","executionInfo":{"status":"ok","timestamp":1794180319314,"user_tz":-60,"elapsed":23522,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"47f665d0-111b-4c1c-b057-f573d355c848"},"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n","Project folder exists: True\n","Trained model exists: True\n","Model path: /content/drive/MyDrive/LULC_Project/unet_sentinel1_finetune_best.pth\n"]}],"source":["\n","from google.colab import drive\n","from pathlib import Path\n","\n","# Connect Google Drive\n","drive.mount(\"/content/drive\")\n","\n","# Our existing project folder\n","PROJECT_DIR = Path(\"/content/drive/MyDrive/LULC_Project\")\n","\n","# Check the trained model\n","MODEL_PATH = PROJECT_DIR / \"unet_sentinel1_finetune_best.pth\"\n","\n","print(\"Project folder exists:\", PROJECT_DIR.exists())\n","print(\"Trained model exists:\", MODEL_PATH.exists())\n","print(\"Model path:\", MODEL_PATH)\n"]},{"cell_type":"code","source":["\n","# Step 2: City coordinates and prediction months\n","\n","CITIES = {\n","    \"Stuttgart\": (48.7758, 9.1829),\n","    \"Mannheim\": (49.4875, 8.4660),\n","    \"Heidelberg\": (49.3988, 8.6724),\n","    \"Karlsruhe\": (49.0069, 8.4037),\n","    \"Freiburg\": (47.9990, 7.8421),\n","    \"Koblenz\": (50.3643, 7.6056),\n","    \"Ulm\": (48.4011, 9.9876),\n","    \"Tübingen\": (48.5216, 9.0576)\n","}\n","\n","# Choose a city for testing\n","selected_city = \"Heidelberg\"\n","\n","latitude, longitude = CITIES[selected_city]\n","\n","# Our project uses only 2021\n","months = [f\"2021-{m:02d}\" for m in range(1, 13)]\n","\n","print(\"Selected city:\", selected_city)\n","print(\"Latitude:\", latitude)\n","print(\"Longitude:\", longitude)\n","print(\"Prediction year: 2021\")\n","print(\"Total months:\", len(months))\n","print(\"Months:\", months)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"9vx8eyXXeobh","executionInfo":{"status":"ok","timestamp":1794180373723,"user_tz":-60,"elapsed":18,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"ce3b6356-d7b9-4e5a-ac47-5927123e83a0"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["Selected city: Heidelberg\n","Latitude: 49.3988\n","Longitude: 8.6724\n","Prediction year: 2021\n","Total months: 12\n","Months: ['2021-01', '2021-02', '2021-03', '2021-04', '2021-05', '2021-06', '2021-07', '2021-08', '2021-09', '2021-10', '2021-11', '2021-12']\n"]}]},{"cell_type":"code","source":["\n","import ee\n","\n","# Connect to Google Earth Engine\n","PROJECT_ID = \"mydataportfolio-484121\"\n","\n","try:\n","    ee.Initialize(project=PROJECT_ID)\n","except Exception:\n","    ee.Authenticate(auth_mode=\"colab\")\n","    ee.Initialize(project=PROJECT_ID)\n","\n","print(\"Earth Engine connected successfully!\")\n","\n","# Heidelberg location from Step 2\n","point = ee.Geometry.Point([longitude, latitude])\n","\n","# Search around the selected city\n","study_area = point.buffer(1800)\n","\n","# Sentinel-1 radar images for 2021\n","sentinel1 = (\n","    ee.ImageCollection(\"COPERNICUS/S1_GRD\")\n","    .filterBounds(study_area)\n","    .filterDate(\"2021-01-01\", \"2022-01-01\")\n","    .filter(ee.Filter.eq(\"instrumentMode\", \"IW\"))\n","    .filter(ee.Filter.eq(\"orbitProperties_pass\", \"DESCENDING\"))\n","    .filter(ee.Filter.listContains(\n","        \"transmitterReceiverPolarisation\", \"VV\"\n","    ))\n","    .filter(ee.Filter.listContains(\n","        \"transmitterReceiverPolarisation\", \"VH\"\n","    ))\n","    .select([\"VV\", \"VH\"])\n",")\n","\n","print(\"Selected city:\", selected_city)\n","print(\"Year: 2021\")\n","print(\"Total Sentinel-1 images:\", sentinel1.size().getInfo())\n","print(\"Radar bands: VV, VH\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"N9FaXe-1e9vZ","executionInfo":{"status":"ok","timestamp":1794180453770,"user_tz":-60,"elapsed":14627,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"534f765c-1905-467c-be44-feb66d9a9103"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["Earth Engine connected successfully!\n","Selected city: Heidelberg\n","Year: 2021\n","Total Sentinel-1 images: 109\n","Radar bands: VV, VH\n"]}]},{"cell_type":"code","source":["import pandas as pd\n","\n","monthly_counts = []\n","\n","for month in months:\n","    start_date = f\"{month}-01\"\n","\n","    # next month\n","    month_number = int(month.split(\"-\")[1])\n","    year_number = int(month.split(\"-\")[0])\n","\n","    if month_number == 12:\n","        end_date = f\"{year_number + 1}-01-01\"\n","    else:\n","        end_date = f\"{year_number}-{month_number + 1:02d}-01\"\n","\n","    month_collection = sentinel1.filterDate(start_date, end_date)\n","    count = month_collection.size().getInfo()\n","\n","    monthly_counts.append({\n","        \"Month\": month,\n","        \"Sentinel-1 Scenes\": count\n","    })\n","\n","monthly_df = pd.DataFrame(monthly_counts)\n","\n","print(\"===== MONTHLY SENTINEL-1 AVAILABILITY =====\")\n","display(monthly_df)\n","\n","all_months_available = (monthly_df[\"Sentinel-1 Scenes\"] > 0).all()\n","print(\"\\nAll 12 months available:\", all_months_available)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":477},"id":"7TwrQ2g8fe6e","executionInfo":{"status":"ok","timestamp":1794180515369,"user_tz":-60,"elapsed":3529,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"d07cf587-a5ae-4642-a795-61bd57b6cfcb"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["===== MONTHLY SENTINEL-1 AVAILABILITY =====\n"]},{"output_type":"display_data","data":{"text/plain":["      Month  Sentinel-1 Scenes\n","0   2021-01                  8\n","1   2021-02                  7\n","2   2021-03                  8\n","3   2021-04                 10\n","4   2021-05                 10\n","5   2021-06                 10\n","6   2021-07                  9\n","7   2021-08                  9\n","8   2021-09                 10\n","9   2021-10                 10\n","10  2021-11                 10\n","11  2021-12                  8"],"text/html":["\n","  <div id=\"df-800f3d2b-b12a-44f3-9464-acdd4fd2409b\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>Month</th>\n","      <th>Sentinel-1 Scenes</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>0</th>\n","      <td>2021-01</td>\n","      <td>8</td>\n","    </tr>\n","    <tr>\n","      <th>1</th>\n","      <td>2021-02</td>\n","      <td>7</td>\n","    </tr>\n","    <tr>\n","      <th>2</th>\n","      <td>2021-03</td>\n","      <td>8</td>\n","    </tr>\n","    <tr>\n","      <th>3</th>\n","      <td>2021-04</td>\n","      <td>10</td>\n","    </tr>\n","    <tr>\n","      <th>4</th>\n","      <td>2021-05</td>\n","      <td>10</td>\n","    </tr>\n","    <tr>\n","      <th>5</th>\n","      <td>2021-06</td>\n","      <td>10</td>\n","    </tr>\n","    <tr>\n","      <th>6</th>\n","      <td>2021-07</td>\n","      <td>9</td>\n","    </tr>\n","    <tr>\n","      <th>7</th>\n","      <td>2021-08</td>\n","      <td>9</td>\n","    </tr>\n","    <tr>\n","      <th>8</th>\n","      <td>2021-09</td>\n","      <td>10</td>\n","    </tr>\n","    <tr>\n","      <th>9</th>\n","      <td>2021-10</td>\n","      <td>10</td>\n","    </tr>\n","    <tr>\n","      <th>10</th>\n","      <td>2021-11</td>\n","      <td>10</td>\n","    </tr>\n","    <tr>\n","      <th>11</th>\n","      <td>2021-12</td>\n","      <td>8</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>\n","    <div class=\"colab-df-buttons\">\n","\n","  <div class=\"colab-df-container\">\n","    <button class=\"colab-df-convert\" onclick=\"convertToInteractive('df-800f3d2b-b12a-44f3-9464-acdd4fd2409b')\"\n","            title=\"Convert this dataframe to an interactive table.\"\n","            style=\"display:none;\">\n","\n","  <svg xmlns=\"http://www.w3.org/2000/svg\" height=\"24px\" viewBox=\"0 -960 960 960\">\n","    <path d=\"M120-120v-720h720v720H120Zm60-500h600v-160H180v160Zm220 220h160v-160H400v160Zm0 220h160v-160H400v160ZM180-400h160v-160H180v160Zm440 0h160v-160H620v160ZM180-180h160v-160H180v160Zm440 0h160v-160H620v160Z\"/>\n","  </svg>\n","    </button>\n","\n","  <style>\n","    .colab-df-container {\n","      display:flex;\n","      gap: 12px;\n","    }\n","\n","    .colab-df-convert {\n","      background-color: #E8F0FE;\n","      border: none;\n","      border-radius: 50%;\n","      cursor: pointer;\n","      display: none;\n","      fill: #1967D2;\n","      height: 32px;\n","      padding: 0 0 0 0;\n","      width: 32px;\n","    }\n","\n","    .colab-df-convert:hover {\n","      background-color: #E2EBFA;\n","      box-shadow: 0px 1px 2px rgba(60, 64, 67, 0.3), 0px 1px 3px 1px rgba(60, 64, 67, 0.15);\n","      fill: #174EA6;\n","    }\n","\n","    .colab-df-buttons div {\n","      margin-bottom: 4px;\n","    }\n","\n","    [theme=dark] .colab-df-convert {\n","      background-color: #3B4455;\n","      fill: #D2E3FC;\n","    }\n","\n","    [theme=dark] .colab-df-convert:hover {\n","      background-color: #434B5C;\n","      box-shadow: 0px 1px 3px 1px rgba(0, 0, 0, 0.15);\n","      filter: drop-shadow(0px 1px 2px rgba(0, 0, 0, 0.3));\n","      fill: #FFFFFF;\n","    }\n","  </style>\n","\n","    <script>\n","      const buttonEl =\n","        document.querySelector('#df-800f3d2b-b12a-44f3-9464-acdd4fd2409b button.colab-df-convert');\n","      buttonEl.style.display =\n","        google.colab.kernel.accessAllowed ? 'block' : 'none';\n","\n","      async function convertToInteractive(key) {\n","        const element = document.querySelector('#df-800f3d2b-b12a-44f3-9464-acdd4fd2409b');\n","        const dataTable =\n","          await google.colab.kernel.invokeFunction('convertToInteractive',\n","                                                    [key], {});\n","        if (!dataTable) return;\n","\n","        const docLinkHtml = 'Like what you see? Visit the ' +\n","          '<a target=\"_blank\" href=https://colab.research.google.com/notebooks/data_table.ipynb>data table notebook</a>'\n","          + ' to learn more about interactive tables.';\n","        element.innerHTML = '';\n","        dataTable['output_type'] = 'display_data';\n","        await google.colab.output.renderOutput(dataTable, element);\n","        const docLink = document.createElement('div');\n","        docLink.innerHTML = docLinkHtml;\n","        element.appendChild(docLink);\n","      }\n","    </script>\n","  </div>\n","\n","\n","  <div id=\"id_4a1cdc51-41b8-4c9a-adfd-7eeaa2389068\">\n","    <style>\n","      .colab-df-generate {\n","        background-color: #E8F0FE;\n","        border: none;\n","        border-radius: 50%;\n","        cursor: pointer;\n","        display: none;\n","        fill: #1967D2;\n","        height: 32px;\n","        padding: 0 0 0 0;\n","        width: 32px;\n","      }\n","\n","      .colab-df-generate:hover {\n","        background-color: #E2EBFA;\n","        box-shadow: 0px 1px 2px rgba(60, 64, 67, 0.3), 0px 1px 3px 1px rgba(60, 64, 67, 0.15);\n","        fill: #174EA6;\n","      }\n","\n","      [theme=dark] .colab-df-generate {\n","        background-color: #3B4455;\n","        fill: #D2E3FC;\n","      }\n","\n","      [theme=dark] .colab-df-generate:hover {\n","        background-color: #434B5C;\n","        box-shadow: 0px 1px 3px 1px rgba(0, 0, 0, 0.15);\n","        filter: drop-shadow(0px 1px 2px rgba(0, 0, 0, 0.3));\n","        fill: #FFFFFF;\n","      }\n","    </style>\n","    <button class=\"colab-df-generate\" onclick=\"generateWithVariable('monthly_df')\"\n","            title=\"Generate code using this dataframe.\"\n","            style=\"display:none;\">\n","\n","  <svg xmlns=\"http://www.w3.org/2000/svg\" height=\"24px\"viewBox=\"0 0 24 24\"\n","       width=\"24px\">\n","    <path d=\"M7,19H8.4L18.45,9,17,7.55,7,17.6ZM5,21V16.75L18.45,3.32a2,2,0,0,1,2.83,0l1.4,1.43a1.91,1.91,0,0,1,.58,1.4,1.91,1.91,0,0,1-.58,1.4L9.25,21ZM18.45,9,17,7.55Zm-12,3A5.31,5.31,0,0,0,4.9,8.1,5.31,5.31,0,0,0,1,6.5,5.31,5.31,0,0,0,4.9,4.9,5.31,5.31,0,0,0,6.5,1,5.31,5.31,0,0,0,8.1,4.9,5.31,5.31,0,0,0,12,6.5,5.46,5.46,0,0,0,6.5,12Z\"/>\n","  </svg>\n","    </button>\n","    <script>\n","      (() => {\n","      const buttonEl =\n","        document.querySelector('#id_4a1cdc51-41b8-4c9a-adfd-7eeaa2389068 button.colab-df-generate');\n","      buttonEl.style.display =\n","        google.colab.kernel.accessAllowed ? 'block' : 'none';\n","\n","      buttonEl.onclick = () => {\n","        google.colab.notebook.generateWithVariable('monthly_df');\n","      }\n","      })();\n","    </script>\n","  </div>\n","\n","    </div>\n","  </div>\n"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"dataframe","variable_name":"monthly_df","summary":"{\n  \"name\": \"monthly_df\",\n  \"rows\": 12,\n  \"fields\": [\n    {\n      \"column\": \"Month\",\n      \"properties\": {\n        \"dtype\": \"object\",\n        \"num_unique_values\": 12,\n        \"samples\": [\n          \"2021-11\",\n          \"2021-10\",\n          \"2021-01\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Sentinel-1 Scenes\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 1,\n        \"min\": 7,\n        \"max\": 10,\n        \"num_unique_values\": 4,\n        \"samples\": [\n          7,\n          9,\n          8\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","All 12 months available: True\n"]}]},{"cell_type":"code","source":["\n","# Step 5: January 2021 radar composite\n","\n","# Convert city centre to EPSG:3035 (metres)\n","center = ee.Geometry.Point(\n","    [longitude, latitude]\n",").transform(\"EPSG:3035\", 1)\n","\n","x, y = center.coordinates().getInfo()\n","\n","# Create a 2.56 km square around the city\n","study_square = ee.Geometry.Rectangle(\n","    [x - 1280, y - 1280, x + 1280, y + 1280],\n","    proj=\"EPSG:3035\",\n","    geodesic=False\n",")\n","\n","# Collect January 2021 radar images\n","january_images = (\n","    sentinel1\n","    .filterBounds(study_square)\n","    .filterDate(\"2021-01-01\", \"2021-02-01\")\n",")\n","\n","# Combine images using the median\n","january_radar = january_images.median().clip(study_square)\n","\n","print(\"City:\", selected_city)\n","print(\"Month: January 2021\")\n","print(\"Scenes:\", january_images.size().getInfo())\n","print(\"Bands:\", january_radar.bandNames().getInfo())\n","print(\"Target image size: 256 x 256 pixels\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"2qbs3pSyfekI","executionInfo":{"status":"ok","timestamp":1794180596838,"user_tz":-60,"elapsed":702,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"f1ac3aa2-b19a-4e74-abf5-f763edd1b08d"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["City: Heidelberg\n","Month: January 2021\n","Scenes: 8\n","Bands: ['VV', 'VH']\n","Target image size: 256 x 256 pixels\n"]}]},{"cell_type":"code","source":["\n","import requests\n","import rasterio\n","import numpy as np\n","\n","# Create a folder for our 2021 results\n","output_folder = (\n","    PROJECT_DIR / \"outputs\" /\n","    \"heidelberg_2021\" / \"monthly_patches\"\n",")\n","output_folder.mkdir(parents=True, exist_ok=True)\n","\n","# Save the January radar image here\n","file_path = output_folder / \"sentinel1_2021-01.tif\"\n","\n","# Define an exact 256 x 256 grid at 10 m resolution\n","left = round((x - 1280) / 10) * 10\n","top = round((y + 1280) / 10) * 10\n","\n","transform = [10, 0, left, 0, -10, top]\n","\n","# Request the actual VV/VH radar pixels\n","download_url = january_radar.toFloat().getDownloadURL({\n","    \"bands\": [\"VV\", \"VH\"],\n","    \"crs\": \"EPSG:3035\",\n","    \"crs_transform\": transform,\n","    \"dimensions\": [256, 256],\n","    \"format\": \"GEO_TIFF\"\n","})\n","\n","# Download and save to Google Drive\n","response = requests.get(download_url, timeout=120)\n","response.raise_for_status()\n","file_path.write_bytes(response.content)\n","\n","# Open the GeoTIFF and inspect it\n","with rasterio.open(file_path) as src:\n","    radar = src.read()\n","    print(\"Image shape:\", radar.shape)\n","    print(\"Bands:\", src.count)\n","    print(\"Coordinate system:\", src.crs)\n","    print(\"Pixel resolution:\", src.res)\n","    print(\"File saved:\", file_path)\n","\n","print(\"Finite pixels:\", np.isfinite(radar).all())\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"VVevcRu3f0C7","executionInfo":{"status":"ok","timestamp":1794180677920,"user_tz":-60,"elapsed":1793,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"7d5cf97a-1dc8-479c-e7f6-9ad674115d97"},"execution_count":6,"outputs":[{"output_type":"stream","name":"stderr","text":["WARNING:rasterio._env:CPLE_AppDefined in sentinel1_2021-01.tif: TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n","WARNING:rasterio._env:CPLE_AppDefined in TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n"]},{"output_type":"stream","name":"stdout","text":["Image shape: (2, 256, 256)\n","Bands: 2\n","Coordinate system: EPSG:3035\n","Pixel resolution: (10.0, 10.0)\n","File saved: /content/drive/MyDrive/LULC_Project/outputs/heidelberg_2021/monthly_patches/sentinel1_2021-01.tif\n","Finite pixels: True\n"]}]},{"cell_type":"code","source":["\n","# Step 7: Normalize Sentinel-1 VV/VH data\n","\n","import numpy as np\n","import rasterio\n","\n","with rasterio.open(file_path) as src:\n","    radar_masked = src.read(masked=True)\n","\n","# Check for hidden missing-data masks\n","invalid_pixels = np.ma.getmaskarray(radar_masked).sum()\n","\n","print(\"Masked pixels:\", invalid_pixels)\n","\n","if invalid_pixels > 0:\n","    raise ValueError(\"Missing radar pixels found!\")\n","\n","radar_raw = radar_masked.data.astype(np.float32)\n","\n","# Same normalization as Notebook 01\n","vv = (np.clip(radar_raw[0], -30, 5) + 30) / 35\n","vh = (np.clip(radar_raw[1], -35, 0) + 35) / 35\n","\n","# Combine both radar bands\n","model_input = np.stack([vv, vh]).astype(np.float32)\n","\n","print(\"Model input shape:\", model_input.shape)\n","print(\"VV range:\", vv.min(), vv.max())\n","print(\"VH range:\", vh.min(), vh.max())\n","print(\"All values valid:\", np.isfinite(model_input).all())\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"n7_J0STLgHkp","executionInfo":{"status":"ok","timestamp":1794180759454,"user_tz":-60,"elapsed":39,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"1dbd6c8e-fc34-471e-efa7-aaeb2e0831c7"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stderr","text":["WARNING:rasterio._env:CPLE_AppDefined in sentinel1_2021-01.tif: TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n","WARNING:rasterio._env:CPLE_AppDefined in TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n"]},{"output_type":"stream","name":"stdout","text":["Masked pixels: 0\n","Model input shape: (2, 256, 256)\n","VV range: 0.17627318 1.0\n","VH range: 0.19117737 1.0\n","All values valid: True\n"]}]},{"cell_type":"code","source":["\n","# Step 8: Load trained U-Net and predict land cover\n","\n","%pip install -q segmentation-models-pytorch==0.6.0\n","\n","import torch\n","import segmentation_models_pytorch as smp\n","\n","# Select GPU if available\n","device = torch.device(\n","    \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",")\n","\n","# Create the same architecture used during training\n","model = smp.Unet(\n","    encoder_name=\"resnet18\",\n","    encoder_weights=None,\n","    in_channels=2,\n","    classes=11\n",").to(device)\n","\n","# Load our existing fine-tuned weights\n","model.load_state_dict(\n","    torch.load(\n","        MODEL_PATH,\n","        map_location=device,\n","        weights_only=True\n","    )\n",")\n","\n","# Switch to prediction mode\n","model.eval()\n","\n","# Convert radar array into a PyTorch tensor\n","input_tensor = torch.from_numpy(\n","    model_input\n",").unsqueeze(0).to(device)\n","\n","# Run the model\n","with torch.inference_mode():\n","    output = model(input_tensor)\n","    prediction = output.argmax(dim=1)\n","\n","# Convert predictions back to NumPy\n","predicted_map = prediction.squeeze(0).cpu().numpy()\n","\n","print(\"Model loaded successfully!\")\n","print(\"Device:\", device)\n","print(\"Input shape:\", tuple(input_tensor.shape))\n","print(\"Prediction shape:\", predicted_map.shape)\n","print(\"Predicted class IDs:\", np.unique(predicted_map))\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"HB-C6Twlgb5z","executionInfo":{"status":"ok","timestamp":1794180852186,"user_tz":-60,"elapsed":27763,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"5debe6b8-3004-49f1-e116-bb3a92aa0fec"},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["Model loaded successfully!\n","Device: cpu\n","Input shape: (1, 2, 256, 256)\n","Prediction shape: (256, 256)\n","Predicted class IDs: [0 2 3 4 7]\n"]}]},{"cell_type":"code","source":["\n","# Step 9: Visualize January 2021 land-cover prediction\n","\n","import matplotlib.pyplot as plt\n","from matplotlib.colors import ListedColormap\n","from matplotlib.patches import Patch\n","\n","# Same 11-class order used during training\n","class_names = [\n","    \"Trees\", \"Shrubland\", \"Grassland\", \"Cropland\",\n","    \"Built-up\", \"Bare land\", \"Snow/Ice\", \"Water\",\n","    \"Wetland\", \"Mangroves\", \"Moss/Lichen\"\n","]\n","\n","# ESA WorldCover class colors\n","class_colors = [\n","    \"#006400\", \"#ffbb22\", \"#ffff4c\", \"#f096ff\",\n","    \"#fa0000\", \"#b4b4b4\", \"#f0f0f0\", \"#0064c8\",\n","    \"#0096a0\", \"#00cf75\", \"#fae6a0\"\n","]\n","\n","cmap = ListedColormap(class_colors)\n","\n","fig, ax = plt.subplots(figsize=(9, 8))\n","\n","ax.imshow(\n","    predicted_map,\n","    cmap=cmap,\n","    vmin=-0.5,\n","    vmax=10.5,\n","    interpolation=\"nearest\"\n",")\n","\n","ax.set_title(\n","    \"Heidelberg - Predicted LULC - January 2021\",\n","    fontsize=14\n",")\n","ax.axis(\"off\")\n","\n","# Show only classes present in the prediction\n","present_classes = np.unique(predicted_map)\n","\n","legend_items = [\n","    Patch(\n","        facecolor=class_colors[i],\n","        label=class_names[i]\n","    )\n","    for i in present_classes\n","]\n","\n","ax.legend(\n","    handles=legend_items,\n","    loc=\"upper center\",\n","    bbox_to_anchor=(0.5, -0.02),\n","    ncol=3\n",")\n","\n","# Save the result in Google Drive\n","map_path = output_folder.parent / \"lulc_2021-01.png\"\n","\n","plt.savefig(\n","    map_path,\n","    dpi=200,\n","    bbox_inches=\"tight\"\n",")\n","\n","plt.show()\n","\n","print(\"LULC map saved:\", map_path)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":758},"id":"ZPgwCMQegrxp","executionInfo":{"status":"ok","timestamp":1794180904936,"user_tz":-60,"elapsed":2259,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"4b215e15-d7a9-40ef-a407-968b88feca7b"},"execution_count":9,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 900x800 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["LULC map saved: /content/drive/MyDrive/LULC_Project/outputs/heidelberg_2021/lulc_2021-01.png\n"]}]},{"cell_type":"code","source":["\n","# Step 10: Calculate land-cover coverage percentages\n","\n","import pandas as pd\n","import numpy as np\n","\n","total_pixels = predicted_map.size\n","\n","results = []\n","\n","for class_id, class_name in enumerate(class_names):\n","    pixel_count = np.sum(predicted_map == class_id)\n","    percentage = (pixel_count / total_pixels) * 100\n","\n","    results.append({\n","        \"Class\": class_name,\n","        \"Pixels\": int(pixel_count),\n","        \"Percentage\": round(percentage, 2)\n","    })\n","\n","coverage_df = pd.DataFrame(results)\n","\n","# Display classes from highest to lowest coverage\n","display(\n","    coverage_df.sort_values(\n","        \"Percentage\", ascending=False\n","    )\n",")\n","\n","print(\"Total coverage:\", coverage_df[\"Percentage\"].sum(), \"%\")\n","\n","# Save the January results\n","csv_path = output_folder.parent / \"coverage_2021-01.csv\"\n","coverage_df.to_csv(csv_path, index=False)\n","\n","print(\"Saved:\", csv_path)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":429},"id":"p-4C-tb6g-4k","executionInfo":{"status":"ok","timestamp":1794180983342,"user_tz":-60,"elapsed":91,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"a43c9c00-d0f7-463b-f948-a4b05b601b5f"},"execution_count":10,"outputs":[{"output_type":"display_data","data":{"text/plain":["          Class  Pixels  Percentage\n","4      Built-up   49400       75.38\n","0         Trees    6918       10.56\n","2     Grassland    4168        6.36\n","3      Cropland    3650        5.57\n","7         Water    1400        2.14\n","1     Shrubland       0        0.00\n","5     Bare land       0        0.00\n","6      Snow/Ice       0        0.00\n","8       Wetland       0        0.00\n","9     Mangroves       0        0.00\n","10  Moss/Lichen       0        0.00"],"text/html":["\n","  <div id=\"df-6fad8a53-4d9c-4540-b347-668aa8cf2414\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>Class</th>\n","      <th>Pixels</th>\n","      <th>Percentage</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>4</th>\n","      <td>Built-up</td>\n","      <td>49400</td>\n","      <td>75.38</td>\n","    </tr>\n","    <tr>\n","      <th>0</th>\n","      <td>Trees</td>\n","      <td>6918</td>\n","      <td>10.56</td>\n","    </tr>\n","    <tr>\n","      <th>2</th>\n","      <td>Grassland</td>\n","      <td>4168</td>\n","      <td>6.36</td>\n","    </tr>\n","    <tr>\n","      <th>3</th>\n","      <td>Cropland</td>\n","      <td>3650</td>\n","      <td>5.57</td>\n","    </tr>\n","    <tr>\n","      <th>7</th>\n","      <td>Water</td>\n","      <td>1400</td>\n","      <td>2.14</td>\n","    </tr>\n","    <tr>\n","      <th>1</th>\n","      <td>Shrubland</td>\n","      <td>0</td>\n","      <td>0.00</td>\n","    </tr>\n","    <tr>\n","      <th>5</th>\n","      <td>Bare land</td>\n","      <td>0</td>\n","      <td>0.00</td>\n","    </tr>\n","    <tr>\n","      <th>6</th>\n","      <td>Snow/Ice</td>\n","      <td>0</td>\n","      <td>0.00</td>\n","    </tr>\n","    <tr>\n","      <th>8</th>\n","      <td>Wetland</td>\n","      <td>0</td>\n","      <td>0.00</td>\n","    </tr>\n","    <tr>\n","      <th>9</th>\n","      <td>Mangroves</td>\n","      <td>0</td>\n","      <td>0.00</td>\n","    </tr>\n","    <tr>\n","      <th>10</th>\n","      <td>Moss/Lichen</td>\n","      <td>0</td>\n","      <td>0.00</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>\n","    <div class=\"colab-df-buttons\">\n","\n","  <div class=\"colab-df-container\">\n","    <button class=\"colab-df-convert\" onclick=\"convertToInteractive('df-6fad8a53-4d9c-4540-b347-668aa8cf2414')\"\n","            title=\"Convert this dataframe to an interactive table.\"\n","            style=\"display:none;\">\n","\n","  <svg xmlns=\"http://www.w3.org/2000/svg\" height=\"24px\" viewBox=\"0 -960 960 960\">\n","    <path d=\"M120-120v-720h720v720H120Zm60-500h600v-160H180v160Zm220 220h160v-160H400v160Zm0 220h160v-160H400v160ZM180-400h160v-160H180v160Zm440 0h160v-160H620v160ZM180-180h160v-160H180v160Zm440 0h160v-160H620v160Z\"/>\n","  </svg>\n","    </button>\n","\n","  <style>\n","    .colab-df-container {\n","      display:flex;\n","      gap: 12px;\n","    }\n","\n","    .colab-df-convert {\n","      background-color: #E8F0FE;\n","      border: none;\n","      border-radius: 50%;\n","      cursor: pointer;\n","      display: none;\n","      fill: #1967D2;\n","      height: 32px;\n","      padding: 0 0 0 0;\n","      width: 32px;\n","    }\n","\n","    .colab-df-convert:hover {\n","      background-color: #E2EBFA;\n","      box-shadow: 0px 1px 2px rgba(60, 64, 67, 0.3), 0px 1px 3px 1px rgba(60, 64, 67, 0.15);\n","      fill: #174EA6;\n","    }\n","\n","    .colab-df-buttons div {\n","      margin-bottom: 4px;\n","    }\n","\n","    [theme=dark] .colab-df-convert {\n","      background-color: #3B4455;\n","      fill: #D2E3FC;\n","    }\n","\n","    [theme=dark] .colab-df-convert:hover {\n","      background-color: #434B5C;\n","      box-shadow: 0px 1px 3px 1px rgba(0, 0, 0, 0.15);\n","      filter: drop-shadow(0px 1px 2px rgba(0, 0, 0, 0.3));\n","      fill: #FFFFFF;\n","    }\n","  </style>\n","\n","    <script>\n","      const buttonEl =\n","        document.querySelector('#df-6fad8a53-4d9c-4540-b347-668aa8cf2414 button.colab-df-convert');\n","      buttonEl.style.display =\n","        google.colab.kernel.accessAllowed ? 'block' : 'none';\n","\n","      async function convertToInteractive(key) {\n","        const element = document.querySelector('#df-6fad8a53-4d9c-4540-b347-668aa8cf2414');\n","        const dataTable =\n","          await google.colab.kernel.invokeFunction('convertToInteractive',\n","                                                    [key], {});\n","        if (!dataTable) return;\n","\n","        const docLinkHtml = 'Like what you see? Visit the ' +\n","          '<a target=\"_blank\" href=https://colab.research.google.com/notebooks/data_table.ipynb>data table notebook</a>'\n","          + ' to learn more about interactive tables.';\n","        element.innerHTML = '';\n","        dataTable['output_type'] = 'display_data';\n","        await google.colab.output.renderOutput(dataTable, element);\n","        const docLink = document.createElement('div');\n","        docLink.innerHTML = docLinkHtml;\n","        element.appendChild(docLink);\n","      }\n","    </script>\n","  </div>\n","\n","\n","    </div>\n","  </div>\n"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"dataframe","summary":"{\n  \"name\": \"print(\\\"Saved:\\\", csv_path)\",\n  \"rows\": 11,\n  \"fields\": [\n    {\n      \"column\": \"Class\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 11,\n        \"samples\": [\n          \"Shrubland\",\n          \"Built-up\",\n          \"Mangroves\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Pixels\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 14595,\n        \"min\": 0,\n        \"max\": 49400,\n        \"num_unique_values\": 6,\n        \"samples\": [\n          49400,\n          6918,\n          0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Percentage\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 22.27204382995948,\n        \"min\": 0.0,\n        \"max\": 75.38,\n        \"num_unique_values\": 6,\n        \"samples\": [\n          75.38,\n          10.56,\n          0.0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Total coverage: 100.00999999999999 %\n","Saved: /content/drive/MyDrive/LULC_Project/outputs/heidelberg_2021/coverage_2021-01.csv\n"]}]},{"cell_type":"code","source":["\n","# Step 11: Reusable monthly radar function\n","\n","def get_monthly_radar(month):\n","\n","    # Start and end dates for this month\n","    start_date = ee.Date(f\"{month}-01\")\n","    end_date = start_date.advance(1, \"month\")\n","\n","    # Select radar images for the month\n","    images = sentinel1.filterDate(\n","        start_date, end_date\n","    ).filterBounds(study_square)\n","\n","    scene_count = images.size().getInfo()\n","\n","    if scene_count == 0:\n","        raise ValueError(f\"No radar images for {month}\")\n","\n","    # Create the monthly radar composite\n","    radar_image = images.median().clip(study_square)\n","\n","    return radar_image, scene_count\n","\n","\n","# Test the function using February 2021\n","february_radar, february_count = get_monthly_radar(\n","    \"2021-02\"\n",")\n","\n","print(\"Selected city:\", selected_city)\n","print(\"Month: February 2021\")\n","print(\"Radar scenes:\", february_count)\n","print(\"Bands:\", february_radar.bandNames().getInfo())\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"b6zsiH_NhSjs","executionInfo":{"status":"ok","timestamp":1794181055223,"user_tz":-60,"elapsed":705,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"34a6495d-fb51-478f-9ef8-5906bc56d3d4"},"execution_count":11,"outputs":[{"output_type":"stream","name":"stdout","text":["Selected city: Heidelberg\n","Month: February 2021\n","Radar scenes: 7\n","Bands: ['VV', 'VH']\n"]}]},{"cell_type":"code","source":["\n","# Step 12: Download and preprocess any month's radar image\n","\n","def prepare_monthly_input(radar_image, month):\n","\n","    # File path for this month\n","    path = output_folder / f\"sentinel1_{month}.tif\"\n","\n","    # Download the 256 x 256 radar image\n","    url = radar_image.toFloat().getDownloadURL({\n","        \"bands\": [\"VV\", \"VH\"],\n","        \"crs\": \"EPSG:3035\",\n","        \"crs_transform\": transform,\n","        \"dimensions\": [256, 256],\n","        \"format\": \"GEO_TIFF\"\n","    })\n","\n","    response = requests.get(url, timeout=120)\n","    response.raise_for_status()\n","    path.write_bytes(response.content)\n","\n","    # Read and verify radar data\n","    with rasterio.open(path) as src:\n","        data = src.read(masked=True)\n","\n","    if np.ma.getmaskarray(data).any():\n","        raise ValueError(f\"Missing radar pixels in {month}\")\n","\n","    raw = data.data.astype(np.float32)\n","\n","    # Apply the same normalization used in training\n","    vv = (np.clip(raw[0], -30, 5) + 30) / 35\n","    vh = (np.clip(raw[1], -35, 0) + 35) / 35\n","\n","    normalized = np.stack([vv, vh]).astype(np.float32)\n","\n","    if not np.isfinite(normalized).all():\n","        raise ValueError(f\"Invalid radar values in {month}\")\n","\n","    return normalized, path\n","\n","\n","# Test our function using February 2021\n","february_input, february_path = prepare_monthly_input(\n","    february_radar, \"2021-02\"\n",")\n","\n","print(\"City:\", selected_city)\n","print(\"Month: February 2021\")\n","print(\"Input shape:\", february_input.shape)\n","print(\"VV range:\", february_input[0].min(), february_input[0].max())\n","print(\"VH range:\", february_input[1].min(), february_input[1].max())\n","print(\"Saved file:\", february_path)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"boemEcQMhj9F","executionInfo":{"status":"ok","timestamp":1794181109568,"user_tz":-60,"elapsed":1483,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"e18110d8-1e4d-46f7-fcdb-97e5a78d0581"},"execution_count":12,"outputs":[{"output_type":"stream","name":"stderr","text":["WARNING:rasterio._env:CPLE_AppDefined in sentinel1_2021-02.tif: TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n","WARNING:rasterio._env:CPLE_AppDefined in TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n"]},{"output_type":"stream","name":"stdout","text":["City: Heidelberg\n","Month: February 2021\n","Input shape: (2, 256, 256)\n","VV range: 0.16126665 1.0\n","VH range: 0.19217132 1.0\n","Saved file: /content/drive/MyDrive/LULC_Project/outputs/heidelberg_2021/monthly_patches/sentinel1_2021-02.tif\n"]}]},{"cell_type":"code","source":["\n","# Step 13: Reusable U-Net prediction function\n","\n","def predict_lulc(normalized_image):\n","\n","    # Convert NumPy image to a PyTorch tensor\n","    tensor = torch.from_numpy(\n","        normalized_image\n","    ).unsqueeze(0).to(device)\n","\n","    # Predict without training the model\n","    model.eval()\n","\n","    with torch.inference_mode():\n","        output = model(tensor)\n","\n","        # Find the most likely class for each pixel\n","        prediction = output.argmax(dim=1)\n","\n","    # Convert back to a NumPy array\n","    predicted_map = prediction.squeeze(0).cpu().numpy()\n","\n","    return predicted_map\n","\n","\n","# Test our function on February 2021\n","february_prediction = predict_lulc(february_input)\n","\n","# Save the predicted class IDs\n","prediction_path = (\n","    output_folder.parent / \"lulc_prediction_2021-02.npy\"\n",")\n","\n","np.save(prediction_path, february_prediction)\n","\n","print(\"City:\", selected_city)\n","print(\"Month: February 2021\")\n","print(\"Prediction shape:\", february_prediction.shape)\n","print(\"Predicted classes:\", np.unique(february_prediction))\n","print(\"Prediction saved:\", prediction_path)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"wKL-0T8HhxB2","executionInfo":{"status":"ok","timestamp":1794181151002,"user_tz":-60,"elapsed":405,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"8ac2b426-fbe1-44d9-ca3b-535825176ee4"},"execution_count":13,"outputs":[{"output_type":"stream","name":"stdout","text":["City: Heidelberg\n","Month: February 2021\n","Prediction shape: (256, 256)\n","Predicted classes: [0 2 3 4 7]\n","Prediction saved: /content/drive/MyDrive/LULC_Project/outputs/heidelberg_2021/lulc_prediction_2021-02.npy\n"]}]},{"cell_type":"code","source":["\n","# Step 14: Generate all 12 monthly LULC predictions\n","\n","monthly_maps = {}\n","monthly_results = []\n","\n","for month in months:\n","\n","    print(f\"\\nProcessing {selected_city}: {month}\")\n","\n","    # 1. Get Sentinel-1 radar imagery\n","    radar_image, scene_count = get_monthly_radar(month)\n","\n","    # 2. Download and normalize VV/VH\n","    normalized_image, radar_path = prepare_monthly_input(\n","        radar_image, month\n","    )\n","\n","    # 3. Predict land cover using U-Net\n","    lulc_map = predict_lulc(normalized_image)\n","\n","    # 4. Store the monthly prediction\n","    monthly_maps[month] = lulc_map\n","\n","    # 5. Save prediction to Google Drive\n","    save_path = output_folder.parent / f\"lulc_prediction_{month}.npy\"\n","    np.save(save_path, lulc_map)\n","\n","    # 6. Calculate class percentages\n","    pixel_counts = np.bincount(\n","        lulc_map.ravel(), minlength=len(class_names)\n","    )\n","\n","    percentages = pixel_counts / pixel_counts.sum() * 100\n","\n","    row = {\n","        \"Month\": month,\n","        \"Scenes\": scene_count\n","    }\n","\n","    for i, name in enumerate(class_names):\n","        row[name] = percentages[i]\n","\n","    monthly_results.append(row)\n","\n","    print(f\"Done! Built-up: {row['Built-up']:.2f}%\")\n","\n","# Create monthly statistics table\n","monthly_coverage_df = pd.DataFrame(monthly_results)\n","\n","monthly_coverage_df.to_csv(\n","    output_folder.parent / \"monthly_class_percentages.csv\",\n","    index=False\n",")\n","\n","print(\"\\nTotal monthly maps:\", len(monthly_maps))\n","print(\"Monthly statistics saved successfully!\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"SQNaLhYnh7aT","executionInfo":{"status":"ok","timestamp":1794181238083,"user_tz":-60,"elapsed":22425,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"0b811842-6851-41c9-f2e8-7e043f799ffc"},"execution_count":14,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Processing Heidelberg: 2021-01\n"]},{"output_type":"stream","name":"stderr","text":["WARNING:rasterio._env:CPLE_AppDefined in sentinel1_2021-01.tif: TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n","WARNING:rasterio._env:CPLE_AppDefined in TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n"]},{"output_type":"stream","name":"stdout","text":["Done! Built-up: 75.38%\n","\n","Processing Heidelberg: 2021-02\n"]},{"output_type":"stream","name":"stderr","text":["WARNING:rasterio._env:CPLE_AppDefined in sentinel1_2021-02.tif: TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n","WARNING:rasterio._env:CPLE_AppDefined in TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n"]},{"output_type":"stream","name":"stdout","text":["Done! Built-up: 81.27%\n","\n","Processing Heidelberg: 2021-03\n"]},{"output_type":"stream","name":"stderr","text":["WARNING:rasterio._env:CPLE_AppDefined in sentinel1_2021-03.tif: TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n","WARNING:rasterio._env:CPLE_AppDefined in TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n"]},{"output_type":"stream","name":"stdout","text":["Done! Built-up: 74.30%\n","\n","Processing Heidelberg: 2021-04\n"]},{"output_type":"stream","name":"stderr","text":["WARNING:rasterio._env:CPLE_AppDefined in sentinel1_2021-04.tif: TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n","WARNING:rasterio._env:CPLE_AppDefined in TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n"]},{"output_type":"stream","name":"stdout","text":["Done! Built-up: 67.67%\n","\n","Processing Heidelberg: 2021-05\n"]},{"output_type":"stream","name":"stderr","text":["WARNING:rasterio._env:CPLE_AppDefined in sentinel1_2021-05.tif: TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n","WARNING:rasterio._env:CPLE_AppDefined in TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n"]},{"output_type":"stream","name":"stdout","text":["Done! Built-up: 68.82%\n","\n","Processing Heidelberg: 2021-06\n"]},{"output_type":"stream","name":"stderr","text":["WARNING:rasterio._env:CPLE_AppDefined in sentinel1_2021-06.tif: TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n","WARNING:rasterio._env:CPLE_AppDefined in TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n"]},{"output_type":"stream","name":"stdout","text":["Done! Built-up: 67.01%\n","\n","Processing Heidelberg: 2021-07\n"]},{"output_type":"stream","name":"stderr","text":["WARNING:rasterio._env:CPLE_AppDefined in sentinel1_2021-07.tif: TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n","WARNING:rasterio._env:CPLE_AppDefined in TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n"]},{"output_type":"stream","name":"stdout","text":["Done! Built-up: 67.57%\n","\n","Processing Heidelberg: 2021-08\n"]},{"output_type":"stream","name":"stderr","text":["WARNING:rasterio._env:CPLE_AppDefined in sentinel1_2021-08.tif: TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n","WARNING:rasterio._env:CPLE_AppDefined in TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n"]},{"output_type":"stream","name":"stdout","text":["Done! Built-up: 73.46%\n","\n","Processing Heidelberg: 2021-09\n"]},{"output_type":"stream","name":"stderr","text":["WARNING:rasterio._env:CPLE_AppDefined in sentinel1_2021-09.tif: TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n","WARNING:rasterio._env:CPLE_AppDefined in TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n"]},{"output_type":"stream","name":"stdout","text":["Done! Built-up: 72.01%\n","\n","Processing Heidelberg: 2021-10\n"]},{"output_type":"stream","name":"stderr","text":["WARNING:rasterio._env:CPLE_AppDefined in sentinel1_2021-10.tif: TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n","WARNING:rasterio._env:CPLE_AppDefined in TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n"]},{"output_type":"stream","name":"stdout","text":["Done! Built-up: 71.95%\n","\n","Processing Heidelberg: 2021-11\n"]},{"output_type":"stream","name":"stderr","text":["WARNING:rasterio._env:CPLE_AppDefined in sentinel1_2021-11.tif: TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n","WARNING:rasterio._env:CPLE_AppDefined in TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n"]},{"output_type":"stream","name":"stdout","text":["Done! Built-up: 71.71%\n","\n","Processing Heidelberg: 2021-12\n"]},{"output_type":"stream","name":"stderr","text":["WARNING:rasterio._env:CPLE_AppDefined in sentinel1_2021-12.tif: TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n","WARNING:rasterio._env:CPLE_AppDefined in TIFFReadDirectory:Sum of Photometric type-related color channels and ExtraSamples doesn't match SamplesPerPixel. Defining non-color channels as ExtraSamples.\n"]},{"output_type":"stream","name":"stdout","text":["Done! Built-up: 74.02%\n","\n","Total monthly maps: 12\n","Monthly statistics saved successfully!\n"]}]},{"cell_type":"code","source":["\n","# Step 15: Visualize all 12 monthly LULC maps\n","\n","import matplotlib.pyplot as plt\n","from matplotlib.colors import ListedColormap\n","from matplotlib.patches import Patch\n","\n","fig, axes = plt.subplots(3, 4, figsize=(16, 13))\n","\n","cmap = ListedColormap(class_colors)\n","\n","for ax, month in zip(axes.flat, months):\n","\n","    # Get the prediction for this month\n","    lulc_map = monthly_maps[month]\n","\n","    # Display the classified map\n","    ax.imshow(\n","        lulc_map,\n","        cmap=cmap,\n","        vmin=-0.5,\n","        vmax=10.5,\n","        interpolation=\"nearest\"\n","    )\n","\n","    ax.set_title(month, fontsize=12)\n","    ax.axis(\"off\")\n","\n","# Legend for the classes predicted during 2021\n","present_ids = sorted(\n","    set().union(\n","        *(set(np.unique(m)) for m in monthly_maps.values())\n","    )\n",")\n","\n","legend_items = [\n","    Patch(facecolor=class_colors[i], label=class_names[i])\n","    for i in present_ids\n","]\n","\n","fig.suptitle(\n","    \"Heidelberg - Monthly LULC Predictions (2021)\",\n","    fontsize=18,\n","    fontweight=\"bold\"\n",")\n","\n","fig.legend(\n","    handles=legend_items,\n","    loc=\"lower center\",\n","    ncol=5,\n","    bbox_to_anchor=(0.5, 0.02)\n",")\n","\n","plt.tight_layout(rect=[0, 0.07, 1, 0.96])\n","\n","# Save the 12-map figure\n","figure_path = (\n","    output_folder.parent / \"monthly_lulc_maps_2021.png\"\n",")\n","\n","plt.savefig(figure_path, dpi=200, bbox_inches=\"tight\")\n","plt.show()\n","\n","print(\"Total maps displayed:\", len(monthly_maps))\n","print(\"Figure saved:\", figure_path)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"71CbDzJWiLSf","executionInfo":{"status":"ok","timestamp":1794181310117,"user_tz":-60,"elapsed":4453,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"0b3b18f0-3dc9-4ff1-e4a7-d01c146353d6"},"execution_count":15,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1600x1300 with 12 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Total maps displayed: 12\n","Figure saved: /content/drive/MyDrive/LULC_Project/outputs/heidelberg_2021/monthly_lulc_maps_2021.png\n"]}]},{"cell_type":"code","source":["\n","# Step 16: Monthly and annual changes in percentage points\n","\n","# Make sure months are in chronological order\n","coverage = monthly_coverage_df.sort_values(\"Month\").reset_index(drop=True)\n","\n","# Calculate month-to-month changes\n","monthly_changes = coverage[class_names].diff()\n","monthly_changes.insert(0, \"Month\", coverage[\"Month\"])\n","\n","# Calculate December minus January\n","annual_changes = pd.DataFrame({\n","    \"Class\": class_names,\n","    \"January (%)\": coverage.loc[0, class_names].values,\n","    \"December (%)\": coverage.loc[11, class_names].values\n","})\n","\n","annual_changes[\"Change (pp)\"] = (\n","    annual_changes[\"December (%)\"]\n","    - annual_changes[\"January (%)\"]\n",")\n","\n","# Save both tables\n","monthly_changes.to_csv(\n","    output_folder.parent / \"monthly_changes_pp.csv\",\n","    index=False\n",")\n","\n","annual_changes.to_csv(\n","    output_folder.parent / \"total_changes_pp.csv\",\n","    index=False\n",")\n","\n","print(\"MONTH-TO-MONTH CHANGES (percentage points)\")\n","display(monthly_changes.round(2))\n","\n","print(\"JANUARY TO DECEMBER CHANGES\")\n","display(annual_changes.round(2))\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":837},"id":"gHF6F0bhihQx","executionInfo":{"status":"ok","timestamp":1794181384386,"user_tz":-60,"elapsed":102,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"4719c67f-f34f-4cf8-d2a0-3a659e61623c"},"execution_count":16,"outputs":[{"output_type":"stream","name":"stdout","text":["MONTH-TO-MONTH CHANGES (percentage points)\n"]},{"output_type":"display_data","data":{"text/plain":["      Month  Trees  Shrubland  Grassland  Cropland  Built-up  Bare land  \\\n","0   2021-01    NaN        NaN        NaN       NaN       NaN        NaN   \n","1   2021-02  -5.55        0.0      -0.66      0.35      5.89        0.0   \n","2   2021-03   1.33        0.0       4.67      1.05     -6.97        0.0   \n","3   2021-04   3.58        0.0       5.81     -3.42     -6.64        0.0   \n","4   2021-05   0.60        0.0      -2.67     -2.47      1.16        0.0   \n","5   2021-06  10.90        0.0      -4.21     -0.21     -1.81        0.0   \n","6   2021-07   3.50        0.0      -3.44     -0.75      0.56        0.0   \n","7   2021-08 -17.57        0.0       3.83      7.47      5.89        0.0   \n","8   2021-09  -0.88        0.0       0.09      2.77     -1.45        0.0   \n","9   2021-10   2.94        0.0      -2.85     -0.34     -0.05        0.0   \n","10  2021-11   2.06        0.0      -1.21     -0.86     -0.24        0.0   \n","11  2021-12   3.05        0.0      -2.52     -2.93      2.32        0.0   \n","\n","    Snow/Ice  Water  Wetland  Mangroves  Moss/Lichen  \n","0        NaN    NaN      NaN        NaN          NaN  \n","1        0.0  -0.02      0.0        0.0          0.0  \n","2        0.0  -0.08      0.0  