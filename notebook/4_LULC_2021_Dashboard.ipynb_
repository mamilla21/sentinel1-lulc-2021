      \"min\": 0.0,\n        \"max\": 74.0234375,\n        \"num_unique_values\": 6,\n        \"samples\": [\n          14.51263427734375,\n          0.0,\n          2.04925537109375\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Change (pp)\",\n      \"properties\": {\n        \"dtype\": \"date\",\n        \"min\": -3.1646728515625,\n        \"max\": 3.95660400390625,\n        \"num_unique_values\": 6,\n        \"samples\": [\n          3.95660400390625,\n          0.0,\n          -0.08697509765625\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}}]},{"cell_type":"code","source":["\n","%%writefile /content/drive/MyDrive/LULC_Project/app_2021.py\n","\n","import streamlit as st\n","import numpy as np\n","import rasterio\n","import matplotlib.pyplot as plt\n","from matplotlib.colors import ListedColormap\n","from pathlib import Path\n","\n","st.set_page_config(page_title=\"LULC Dashboard 2021\", layout=\"wide\")\n","\n","st.title(\"Sentinel-1 LULC Dashboard — 2021\")\n","\n","# City and month selectors\n","cities = [\"Heidelberg\", \"Stuttgart\", \"Mannheim\",\n","          \"Karlsruhe\", \"Freiburg\", \"Koblenz\"]\n","\n","city = st.sidebar.selectbox(\"Select city\", cities)\n","month = st.sidebar.selectbox(\n","    \"Select month\",\n","    [f\"2021-{m:02d}\" for m in range(1, 13)]\n",")\n","\n","# Locate previously generated files\n","folder = Path(\"/content/drive/MyDrive/LULC_Project/outputs\")\n","city_folder = folder / f\"{city.lower()}_2021\"\n","\n","radar_file = city_folder / \"monthly_patches\" / f\"sentinel1_{month}.tif\"\n","prediction_file = city_folder / f\"lulc_prediction_{month}.npy\"\n","\n","if not radar_file.exists() or not prediction_file.exists():\n","    st.warning(\"This city's 2021 maps have not been generated yet.\")\n","    st.stop()\n","\n","# Read real radar and predicted land-cover map\n","with rasterio.open(radar_file) as src:\n","    vv_image = src.read(1)\n","\n","lulc_map = np.load(prediction_file)\n","\n","colors = [\n","    \"#006400\", \"#ffbb22\", \"#ffff4c\", \"#f096ff\",\n","    \"#fa0000\", \"#b4b4b4\", \"#f0f0f0\", \"#0064c8\",\n","    \"#0096a0\", \"#00cf75\", \"#fae6a0\"\n","]\n","\n","col1, col2 = st.columns(2)\n","\n","with col1:\n","    st.subheader(\"Before — Sentinel-1 VV radar\")\n","    fig1, ax1 = plt.subplots()\n","    ax1.imshow(vv_image, cmap=\"gray\", vmin=-30, vmax=5)\n","    ax1.axis(\"off\")\n","    st.pyplot(fig1)\n","    plt.close(fig1)\n","\n","with col2:\n","    st.subheader(\"After — Predicted LULC\")\n","    fig2, ax2 = plt.subplots()\n","    ax2.imshow(\n","        lulc_map,\n","        cmap=ListedColormap(colors),\n","        vmin=-0.5,\n","        vmax=10.5\n","    )\n","    ax2.axis(\"off\")\n","    st.pyplot(fig2)\n","    plt.close(fig2)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ODTeYZmLi0cw","executionInfo":{"status":"ok","timestamp":1794181556571,"user_tz":-60,"elapsed":41,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"71a52b81-9679-4e2d-999a-8781b273ef18"},"execution_count":17,"outputs":[{"output_type":"stream","name":"stdout","text":["Writing /content/drive/MyDrive/LULC_Project/app_2021.py\n"]}]},{"cell_type":"code","source":["\n","# Step 18: Launch Streamlit in Google Colab\n","\n","%pip install -q streamlit\n","\n","import subprocess\n","import sys\n","import time\n","from google.colab import output\n","\n","app_path = \"/content/drive/MyDrive/LULC_Project/app_2021.py\"\n","\n","# Start the Streamlit server\n","streamlit_process = subprocess.Popen([\n","    sys.executable, \"-m\", \"streamlit\", \"run\",\n","    app_path,\n","    \"--server.port=8501\",\n","    \"--server.address=0.0.0.0\",\n","    \"--server.headless=true\"\n","])\n","\n","# Allow the server to start\n","time.sleep(5)\n","\n","if streamlit_process.poll() is None:\n","    print(\"Streamlit dashboard started!\")\n","    output.serve_kernel_port_as_iframe(8501, height=850)\n","else:\n","    print(\"Streamlit could not start. Check the error above.\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"LZ27Mkzsjeg9","executionInfo":{"status":"ok","timestamp":1794181864797,"user_tz":-60,"elapsed":15468,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"446f4b27-2088-4ddc-b7d7-60aad7f37329"},"execution_count":20,"outputs":[{"output_type":"stream","name":"stdout","text":["Streamlit could not start. Check the error above.\n"]}]},{"cell_type":"code","source":["\n","# Check whether Streamlit is running\n","\n","import requests\n","from pathlib import Path\n","\n","app_path = Path(\n","    \"/content/drive/MyDrive/LULC_Project/app_2021.py\"\n",")\n","\n","print(\"Dashboard file exists:\", app_path.exists())\n","\n","try:\n","    response = requests.get(\n","        \"http://127.0.0.1:8501/_stcore/health\",\n","        timeout=5\n","    )\n","    print(\"Streamlit HTTP status:\", response.status_code)\n","    print(\"Server response:\", response.text)\n","except Exception as e:\n","    print(\"Streamlit is not responding\")\n","    print(\"Error:\", str(e))\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"mIsVu_ZgjxBg","executionInfo":{"status":"ok","timestamp":1794181866033,"user_tz":-60,"elapsed":45,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"3319059e-67ec-4748-e71b-ad8159008159"},"execution_count":21,"outputs":[{"output_type":"stream","name":"stdout","text":["Dashboard file exists: True\n","Streamlit HTTP status: 200\n","Server response: ok\n"]}]},{"cell_type":"code","source":["\n","# Step 18B: Display the existing Streamlit dashboard\n","\n","from google.colab import output\n","\n","print(\"Opening LULC 2021 Dashboard...\")\n","\n","output.serve_kernel_port_as_iframe(\n","    8501,\n","    height=900\n",")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":939},"id":"r5UyzItxkqEX","executionInfo":{"status":"ok","timestamp":1794181947123,"user_tz":-60,"elapsed":56,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"537da959-1a67-4a2a-f773-5325dd86c38e"},"execution_count":22,"outputs":[{"output_type":"stream","name":"stdout","text":["Opening LULC 2021 Dashboard...\n"]},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["(async (port, path, width, height, cache, element) => {\n","    if (!google.colab.kernel.accessAllowed && !cache) {\n","      return;\n","    }\n","    element.appendChild(document.createTextNode(''));\n","    const url = await google.colab.kernel.proxyPort(port, {cache});\n","    const iframe = document.createElement('iframe');\n","    iframe.src = new URL(path, url).toString();\n","    iframe.height = height;\n","    iframe.width = width;\n","    iframe.style.border = 0;\n","    iframe.allow = [\n","        'accelerometer',\n","        'autoplay',\n","        'camera',\n","        'clipboard-read',\n","        'clipboard-write',\n","        'gyroscope',\n","        'magnetometer',\n","        'microphone',\n","        'serial',\n","        'usb',\n","        'xr-spatial-tracking',\n","    ].join('; ');\n","    element.appendChild(iframe);\n","  })(8501, \"/\", \"100%\", 900, false, window.element)"]},"metadata":{}}]},{"cell_type":"code","source":["\n","# Open the existing Streamlit server in a new browser tab\n","from google.colab import output\n","\n","output.serve_kernel_port_as_window(8501)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":69},"id":"XCsuf1Axk93U","executionInfo":{"status":"ok","timestamp":1794182370337,"user_tz":-60,"elapsed":71,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"f587b283-f7ab-447a-c648-e3ae0f35f045"},"execution_count":23,"outputs":[{"output_type":"stream","name":"stdout","text":["\u001b[31mWarning: This function may stop working due to changes in browser security.\n","Try `serve_kernel_port_as_iframe` instead. \u001b[0m\n"]},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["(async (port, path, text, element) => {\n","    if (!google.colab.kernel.accessAllowed) {\n","      return;\n","    }\n","    element.appendChild(document.createTextNode(''));\n","    const url = await google.colab.kernel.proxyPort(port);\n","    const anchor = document.createElement('a');\n","    anchor.href = new URL(path, url).toString();\n","    anchor.target = '_blank';\n","    anchor.setAttribute('data-href', url + path);\n","    anchor.textContent = text;\n","    element.appendChild(anchor);\n","  })(8501, \"/\", \"https://localhost:8501/\", window.element)"]},"metadata":{}}]},{"cell_type":"code","source":["\n","# Step 18D: Restart Streamlit and capture errors\n","\n","import subprocess\n","import sys\n","import time\n","import os\n","\n","# Stop any previous Streamlit server on port 8501\n","subprocess.run(\n","    \"fuser -k 8501/tcp\",\n","    shell=True,\n","    capture_output=True\n",")\n","\n","app_path = \"/content/drive/MyDrive/LULC_Project/app_2021.py\"\n","log_path = \"/content/streamlit_2021.log\"\n","\n","# Start a fresh Streamlit server\n","log_file = open(log_path, \"w\")\n","\n","process = subprocess.Popen(\n","    [\n","        sys.executable, \"-m\", \"streamlit\", \"run\",\n","        app_path,\n","        \"--server.port=8501\",\n","        \"--server.address=0.0.0.0\",\n","        \"--server.headless=true\",\n","        \"--server.enableCORS=false\",\n","        \"--server.enableXsrfProtection=false\",\n","        \"--server.enableWebsocketCompression=false\",\n","    ],\n","    stdout=log_file,\n","    stderr=subprocess.STDOUT\n",")\n","\n","time.sleep(5)\n","\n","print(\"Process running:\", process.poll() is None)\n","\n","with open(log_path) as f:\n","    print(\"\\nSTREAMLIT LOGS:\")\n","    print(f.read()[-3000:])\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"onuwUkdSmlLf","executionInfo":{"status":"ok","timestamp":1794182470723,"user_tz":-60,"elapsed":5053,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"72497bd9-13fc-4e6e-80e2-6037e45951a4"},"execution_count":24,"outputs":[{"output_type":"stream","name":"stdout","text":["Process running: True\n","\n","STREAMLIT LOGS:\n","\n","Collecting usage statistics. To deactivate, set browser.gatherUsageStats to false.\n","\n","\n"]}]},{"cell_type":"code","source":["\n","# Step 20: Add a Generate Maps button to Streamlit\n","\n","from pathlib import Path\n","\n","app_path = Path(\n","    \"/content/drive/MyDrive/LULC_Project/app_2021.py\"\n",")\n","\n","# Read our existing dashboard code\n","app_code = app_path.read_text(encoding=\"utf-8\")\n","\n","# Add a button immediately after the city dropdown\n","old_line = 'city = st.sidebar.selectbox(\"Select city\", cities)'\n","\n","new_lines = '''city = st.sidebar.selectbox(\"Select city\", cities)\n","\n","generate_clicked = st.sidebar.button(\n","    \"Generate 12 Monthly Maps\",\n","    type=\"primary\"\n",")\n","\n","if generate_clicked:\n","    st.sidebar.success(f\"Generation requested for {city} (2021)\")\n","'''\n","\n","if old_line in app_code and \"generate_clicked\" not in app_code:\n","    app_code = app_code.replace(old_line, new_lines, 1)\n","    app_path.write_text(app_code, encoding=\"utf-8\")\n","    print(\"Generate Maps button added successfully!\")\n","elif \"generate_clicked\" in app_code:\n","    print(\"Button already exists.\")\n","else:\n","    print(\"Could not find the city dropdown line.\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"LbcwH26Wm8eh","executionInfo":{"status":"ok","timestamp":1794182630844,"user_tz":-60,"elapsed":54,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"30229ebe-7076-409d-d4be-00c030af6e6e"},"execution_count":25,"outputs":[{"output_type":"stream","name":"stdout","text":["Generate Maps button added successfully!\n"]}]},{"cell_type":"code","source":["\n","# Step 21: Copy our previous full dashboard\n","\n","from pathlib import Path\n","import shutil\n","\n","project = Path(\"/content/drive/MyDrive/LULC_Project\")\n","\n","old_app = project / \"app.py\"\n","new_full_app = project / \"app_2021_full.py\"\n","\n","if old_app.exists():\n","\n","    if not new_full_app.exists():\n","        shutil.copy2(old_app, new_full_app)\n","        print(\"Full dashboard copied successfully!\")\n","    else:\n","        print(\"2021 full dashboard copy already exists.\")\n","\n","    code = new_full_app.read_text(encoding=\"utf-8\")\n","\n","    print(\"Original app size:\", old_app.stat().st_size, \"bytes\")\n","    print(\"2021 copy:\", new_full_app)\n","    print(\"2025 references:\", code.count(\"2025\"))\n","    print(\"2021 references:\", code.count(\"2021\"))\n","\n","else:\n","    print(\"Previous app.py was not found.\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"hmrMo1WOnkyX","executionInfo":{"status":"ok","timestamp":1794182797424,"user_tz":-60,"elapsed":534,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"635b844a-5bf9-493d-8a43-b52b54007fb2"},"execution_count":26,"outputs":[{"output_type":"stream","name":"stdout","text":["Full dashboard copied successfully!\n","Original app size: 19502 bytes\n","2021 copy: /content/drive/MyDrive/LULC_Project/app_2021_full.py\n","2025 references: 2\n","2021 references: 1\n"]}]},{"cell_type":"code","source":["\n","# Step 22: Inspect the full dashboard code\n","\n","from pathlib import Path\n","\n","app_file = Path(\n","    \"/content/drive/MyDrive/LULC_Project/app_2021_full.py\"\n",")\n","\n","lines = app_file.read_text(\n","    encoding=\"utf-8\"\n",").splitlines()\n","\n","keywords = [\n","    \"2025\",\n","    \"2021\",\n","    \"start_month\",\n","    \"selectbox\",\n","    \"button\",\n","    \"suggested region\"\n","]\n","\n","print(\"===== DASHBOARD CODE INSPECTION =====\")\n","\n","for i, line in enumerate(lines):\n","    if any(word in line.lower() for word in keywords):\n","        print(f\"Line {i + 1}: {line.strip()}\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"sUTD2yyQoNV3","executionInfo":{"status":"ok","timestamp":1794182850217,"user_tz":-60,"elapsed":45,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"f612c5c4-3d5c-4434-f4be-713d96998fbd"},"execution_count":27,"outputs":[{"output_type":"stream","name":"stdout","text":["===== DASHBOARD CODE INSPECTION =====\n","Line 234: st.selectbox(\"Suggested region\", list(PRESETS.keys()) + [\"Custom coordinates\"],\n","Line 241: start_month = st.text_input(\"Starting month (YYYY-MM)\", value=\"2025-01\")\n","Line 242: run = st.form_submit_button(\"▶ Generate 12 Monthly Maps\", use_container_width=True,\n","Line 255: \"2021 WorldCover labels were used for supervised training.\")\n","Line 280: if len(start_month) != 7 or start_month[4] != \"-\" or not (start_month[:4] + start_month[5:]).isdigit():\n","Line 281: raise ValueError(\"Enter a valid start month in YYYY-MM format, e.g. 2025-01\")\n","Line 282: first = pd.Period(start_month, freq=\"M\")\n","Line 368: st.download_button(\"⬇ Download 12-map figure (PNG)\", maps_png,\n","Line 378: st.download_button(\"⬇ Download coverage CSV\", coverage.to_csv(index=False),\n","Line 386: st.download_button(\"⬇ Download total changes CSV\", first_to_last.to_csv(index=False),\n","Line 396: current_month = st.selectbox(\"Select current month\", months[1:], index=0)\n","Line 407: st.download_button(\"⬇ Download before/after comparison (PNG)\", diff_png,\n","Line 429: st.download_button(\"⬇ Download trend graph (PNG)\", trend_png,\n","Line 437: st.download_button(\"⬇ Download monthly change CSV\", monthly_change.to_csv(index=False),\n"]}]},{"cell_type":"code","source":["\n","# Step 23: Set dashboard prediction year to 2021\n","\n","from pathlib import Path\n","\n","app_file = Path(\n","    \"/content/drive/MyDrive/LULC_Project/app_2021_full.py\"\n",")\n","\n","code = app_file.read_text(encoding=\"utf-8\")\n","\n","# Find the old 2025 starting month\n","old = 'st.text_input(\"Starting month (YYYY-MM)\", value=\"2025-01\")'\n","\n","# Replace it with a fixed 2021 starting month\n","new = 'st.text_input(\"Starting month (YYYY-MM)\", value=\"2021-01\", disabled=True)'\n","\n","if code.count(old) == 1:\n","\n","    updated = code.replace(old, new, 1)\n","\n","    # Update the example in the error message\n","    updated = updated.replace(\n","        \"e.g. 2025-01\",\n","        \"e.g. 2021-01\"\n","    )\n","\n","    # Check Python syntax before saving\n","    compile(updated, str(app_file), \"exec\")\n","\n","    app_file.write_text(updated, encoding=\"utf-8\")\n","\n","    print(\"Dashboard year updated successfully!\")\n","    print(\"Start month: 2021-01\")\n","    print(\"Prediction period: January–December 2021\")\n","    print(\"Remaining 2025 references:\", updated.count(\"2025\"))\n","\n","else:\n","    print(\"Expected date setting not found. No changes made.\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"d7KugmJhoaWS","executionInfo":{"status":"ok","timestamp":1794182924452,"user_tz":-60,"elapsed":46,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"b53fbec6-09e7-45c6-8fed-e87a2c2f5a49"},"execution_count":28,"outputs":[{"output_type":"stream","name":"stdout","text":["Dashboard year updated successfully!\n","Start month: 2021-01\n","Prediction period: January–December 2021\n","Remaining 2025 references: 0\n"]}]},{"cell_type":"code","source":["\n","# Step 24: Inspect existing city presets and generation logic\n","\n","from pathlib import Path\n","\n","app_file = Path(\n","    \"/content/drive/MyDrive/LULC_Project/app_2021_full.py\"\n",")\n","\n","lines = app_file.read_text(encoding=\"utf-8\").splitlines()\n","\n","# Show the beginning of the original app\n","print(\"===== CITY PRESETS AND MODEL SETUP =====\")\n","\n","for number, line in enumerate(lines[:115], start=1):\n","    print(f\"{number:03d}: {line}\")\n","\n","print(\"\\n===== MAP GENERATION LOGIC =====\")\n","\n","for number in range(225, min(330, len(lines))):\n","    print(f\"{number+1:03d}: {lines[number]}\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"mInc6yNfoseF","executionInfo":{"status":"ok","timestamp":1794182941486,"user_tz":-60,"elapsed":87,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"e5aead46-67cd-4211-9247-a313b407d7d8"},"execution_count":29,"outputs":[{"output_type":"stream","name":"stdout","text":["===== CITY PRESETS AND MODEL SETUP =====\n","001: \"\"\"Sentinel-1 monthly land-cover research dashboard.\n","002: \n","003: Run with:\n","004:     streamlit run app.py\n","005: \n","006: Earth Engine access must be authenticated separately in the environment running\n","007: Streamlit. All output maps and statistics are model predictions, NOT ground truth.\n","008: \"\"\"\n","009: \n","010: import io\n","011: import os\n","012: from pathlib import Path\n","013: \n","014: import ee\n","015: import matplotlib.pyplot as plt\n","016: import numpy as np\n","017: import pandas as pd\n","018: import requests\n","019: import segmentation_models_pytorch as smp\n","020: import streamlit as st\n","021: import torch\n","022: from matplotlib.colors import BoundaryNorm, ListedColormap\n","023: from matplotlib.patches import Patch\n","024: from pyproj import Transformer\n","025: from rasterio.io import MemoryFile\n","026: \n","027: \n","028: st.set_page_config(\n","029:     page_title=\"Sentinel-1 | Monthly LULC Monitoring\",\n","030:     page_icon=\"🛰️\",\n","031:     layout=\"wide\",\n","032:     initial_sidebar_state=\"expanded\",\n","033: )\n","034: \n","035: PROJECT_DIR = Path(__file__).resolve().parent\n","036: WEIGHTS = PROJECT_DIR / \"unet_sentinel1_finetune_best.pth\"\n","037: EE_PROJECT = os.environ.get(\"EE_PROJECT\", \"mydataportfolio-484121\")\n","038: \n","039: CLASSES = [\n","040:     \"Trees\", \"Shrubland\", \"Grassland\", \"Cropland\", \"Built-up\", \"Bare land\",\n","041:     \"Snow/Ice\", \"Water\", \"Wetland\", \"Mangroves\", \"Moss/Lichen\",\n","042: ]\n","043: COLORS = [\n","044:     \"#006400\", \"#ffbb22\", \"#ffff4c\", \"#f096ff\", \"#fa0000\", \"#b4b4b4\",\n","045:     \"#f0f0f0\", \"#0064c8\", \"#0096a0\", \"#00cf75\", \"#fae6a0\",\n","046: ]\n","047: COLOR_MAP = ListedColormap(COLORS)\n","048: COLOR_NORM = BoundaryNorm(np.arange(-0.5, 11.5, 1), COLOR_MAP.N)\n","049: MAIN_CLASSES = [\"Trees\", \"Grassland\", \"Cropland\", \"Built-up\", \"Water\"]\n","050: PRESETS = {\n","051:     \"Koblenz · Rhine & Moselle\": (50.3643, 7.6056),\n","052:     \"Stuttgart · City centre\": (48.7758, 9.1829),\n","053:     \"Passau · Three rivers\": (48.57356, 13.47636),\n","054: }\n","055: \n","056: \n","057: # Light, polished interface. Styling never modifies the actual model outputs.\n","058: st.markdown(\n","059:     \"\"\"\n","060:     <style>\n","061:     .stApp { background: #f7f9fc; color: #173052; }\n","062:     [data-testid=\"stSidebar\"] { background: #eef3fb; border-right: 1px solid #e3eaf6; }\n","063:     [data-testid=\"stSidebar\"] h2, [data-testid=\"stSidebar\"] h3 { color: #18375f; }\n","064:     .block-container { padding-top: 1.3rem; padding-bottom: 2rem; max-width: 1800px; }\n","065:     .hero-title { font-size: 2rem; font-weight: 850; color: #183b78; letter-spacing: -.04em; }\n","066:     .hero-desc { color: #53677f; margin-top: .15rem; margin-bottom: .75rem; }\n","067:     .section-title { font-size: 1.16rem; color: #173969; font-weight: 800; margin: .2rem 0 .75rem; }\n","068:     .muted-note { font-size: .86rem; color: #5c7189; }\n","069:     .class-key { display:flex; align-items:center; gap:.6rem; margin: .32rem 0; font-size:.9rem; }\n","070:     .key-swatch { width: 17px; height:17px; border:1px solid #d3dbe6; border-radius:4px; display:inline-block; }\n","071:     [data-testid=\"stMetric\"] { background: #fff; border: 1px solid #e4eaf3; border-radius: 10px; padding: 12px 15px; }\n","072:     div[data-testid=\"stVerticalBlockBorderWrapper\"] > div { border-color:#e5ebf4; }\n","073:     </style>\n","074:     \"\"\",\n","075:     unsafe_allow_html=True,\n","076: )\n","077: \n","078: \n","079: @st.cache_resource(show_spinner=False)\n","080: def get_model():\n","081:     \"\"\"Initialize Earth Engine and load the saved fine-tuned U-Net on CPU.\"\"\"\n","082:     if not WEIGHTS.exists():\n","083:         raise FileNotFoundError(f\"Missing trained weights: {WEIGHTS.name}\")\n","084:     ee.Initialize(project=EE_PROJECT)\n","085:     net = smp.Unet(\n","086:         encoder_name=\"resnet18\", encoder_weights=None, in_channels=2, classes=11\n","087:     )\n","088:     net.load_state_dict(torch.load(WEIGHTS, map_location=\"cpu\", weights_only=True))\n","089:     net.eval()\n","090:     return net\n","091: \n","092: \n","093: def predict_one_month(net, latitude, longitude, start_date, end_date):\n","094:     \"\"\"Download one monthly SAR median in EPSG:3035 and infer one 256x256 LULC map.\"\"\"\n","095:     tx = Transformer.from_crs(\"EPSG:4326\", \"EPSG:3035\", always_xy=True)\n","096:     cx, cy = tx.transform(longitude, latitude)\n","097:     xmin, ymax = cx - 1280.0, cy + 1280.0\n","098:     roi = ee.Geometry.Rectangle(\n","099:         [cx - 1280, cy - 1280, cx + 1280, cy + 1280],\n","100:         proj=\"EPSG:3035\", geodesic=False,\n","101:     )\n","102:     s1 = (\n","103:         ee.ImageCollection(\"COPERNICUS/S1_GRD\")\n","104:         .filterBounds(roi)\n","105:         .filterDate(start_date, end_date)\n","106:         .filter(ee.Filter.eq(\"instrumentMode\", \"IW\"))\n","107:         .filter(ee.Filter.eq(\"orbitProperties_pass\", \"DESCENDING\"))\n","108:         .filter(ee.Filter.listContains(\"transmitterReceiverPolarisation\", \"VV\"))\n","109:         .filter(ee.Filter.listContains(\"transmitterReceiverPolarisation\", \"VH\"))\n","110:         .select([\"VV\", \"VH\"])\n","111:     )\n","112:     scene_count = int(s1.size().getInfo())\n","113:     if scene_count == 0:\n","114:         raise ValueError(f\"No matching Sentinel-1 observations for {start_date[:7]}\")\n","115: \n","\n","===== MAP GENERATION LOGIC =====\n","226: if \"longitude_input\" not in st.session_state:\n","227:     st.session_state[\"longitude_input\"] = 7.6056\n","228: \n","229: with st.sidebar:\n","230:     st.markdown(\"### 🛰️ LULC Monitoring\")\n","231:     st.caption(\"Sentinel-1 · U-Net\")\n","232:     st.divider()\n","233:     st.markdown(\"### Location & time\")\n","234:     st.selectbox(\"Suggested region\", list(PRESETS.keys()) + [\"Custom coordinates\"],\n","235:                  key=\"city_preset\", on_change=on_city_change)\n","236:     with st.form(\"run_form\"):\n","237:         latitude = st.number_input(\"Latitude\", min_value=-90.0, max_value=90.0,\n","238:                                    format=\"%.6f\", key=\"latitude_input\")\n","239:         longitude = st.number_input(\"Longitude\", min_value=-180.0, max_value=180.0,\n","240:                                     format=\"%.6f\", key=\"longitude_input\")\n","241:         start_month = st.text_input(\"Starting month (YYYY-MM)\", value=\"2021-01\", disabled=True)\n","242:         run = st.form_submit_button(\"▶ Generate 12 Monthly Maps\", use_container_width=True,\n","243:                                     type=\"primary\")\n","244: \n","245:     st.divider()\n","246:     st.markdown(\"### Land-cover classes\")\n","247:     for name, color in zip(CLASSES, COLORS):\n","248:         st.markdown(\n","249:             f'<div class=\"class-key\"><span class=\"key-swatch\" style=\"background:{color}\"></span>{name}</div>',\n","250:             unsafe_allow_html=True,\n","251:         )\n","252:     st.divider()\n","253:     st.markdown(\"### About\")\n","254:     st.caption(\"Semantic segmentation with Sentinel-1 VV/VH radar input only. \"\n","255:                \"2021 WorldCover labels were used for supervised training.\")\n","256: \n","257: \n","258: # ---- Headline and model check ----------------------------------------------\n","259: st.markdown('<div class=\"hero-title\">🛰️ Sentinel-1 Monthly LULC Monitoring</div>',\n","260:             unsafe_allow_html=True)\n","261: st.markdown('<div class=\"hero-desc\">Radar-only U-Net research prototype · 12 monthly maps, '\n","262:             'land-cover statistics and before/after comparisons</div>',\n","263:             unsafe_allow_html=True)\n","264: \n","265: try:\n","266:     model = get_model()\n","267: except Exception as exc:\n","268:     st.error(f\"Initialization failed: {exc}\")\n","269:     st.info(\"In Colab, authenticate with ee.Authenticate() in the notebook, \"\n","270:             \"then restart the Streamlit server. Check that the fine-tuned \"\n","271:             \"model weights are saved alongside app.py.\")\n","272:     st.stop()\n","273: else:\n","274:     st.success(\"U-Net model and Google Earth Engine connected\")\n","275: \n","276: \n","277: # ---- Prediction (run only on user action) -----------------------------------\n","278: if run:\n","279:     try:\n","280:         if len(start_month) != 7 or start_month[4] != \"-\" or not (start_month[:4] + start_month[5:]).isdigit():\n","281:             raise ValueError(\"Enter a valid start month in YYYY-MM format, e.g. 2021-01\")\n","282:         first = pd.Period(start_month, freq=\"M\")\n","283:         periods = pd.period_range(first, periods=12, freq=\"M\")\n","284:         if periods[-1].end_time > pd.Timestamp.now():\n","285:             raise ValueError(\"Choose a start month for which all 12 months have finished\")\n","286: \n","287:         months, maps, radar_images, rows, scenes = [], [], [], [], []\n","288:         progress = st.progress(0)\n","289:         status = st.empty()\n","290:         for i, p in enumerate(periods):\n","291:             month = str(p)\n","292:             status.caption(f\"Retrieving Sentinel-1 and predicting {month} ({i+1}/12)\")\n","293:             prediction, radar_rgb, scene_count = predict_one_month(\n","294:                 model, latitude, longitude,\n","295:                 p.start_time.strftime(\"%Y-%m-%d\"),\n","296:                 (p + 1).start_time.strftime(\"%Y-%m-%d\"),\n","297:             )\n","298:             months.append(month)\n","299:             maps.append(prediction)\n","300:             radar_images.append(radar_rgb)\n","301:             scenes.append(scene_count)\n","302:             counts = np.bincount(prediction.ravel(), minlength=len(CLASSES))\n","303:             rows.append({\"Month\": month, **dict(zip(CLASSES, 100 * counts / counts.sum()))})\n","304:             progress.progress((i + 1) / 12)\n","305:         status.empty()\n","306:         progress.empty()\n","307:         st.session_state[\"lulc_results\"] = {\n","308:             \"months\": months,\n","309:             \"maps\": maps,\n","310:             \"radar_images\": radar_images,\n","311:             \"coverage\": pd.DataFrame(rows),\n","312:             \"scenes\": scenes,\n","313:             \"latitude\": latitude,\n","314:             \"longitude\": longitude,\n","315:             \"selected_region\": st.session_state.get(\"city_preset\", \"Custom coordinates\"),\n","316:         }\n","317:         st.toast(\"12 monthly predictions generated\", icon=\"✅\")\n","318:     except Exception as exc:\n","319:         st.error(f\"Monthly processing failed: {exc}\")\n","320:         st.caption(\"Any results from a prior successful run remain below, if available.\")\n","321: \n","322: \n","323: # ---- Results (persist across widget reruns) --------------------------------\n","324: if \"lulc_results\" not in st.session_state:\n","325:     st.info(\"Choose a location in the sidebar and click **Generate 12 Monthly Maps**. \"\n","326:             \"The dashboard will display real outputs from your saved U-Net model.\")\n","327:     st.warning(\"Research limitation: the model overpredicts Built-up land at some locations. \"\n","328:                \"Colourful predictions do not imply accuracy.\")\n","329:     st.stop()\n","330: \n"]}]},{"cell_type":"code","source":["\n","# Step 25: Add cities to the full dashboard\n","\n","from pathlib import Path\n","\n","app_file = Path(\n","    \"/content/drive/MyDrive/LULC_Project/app_2021_full.py\"\n",")\n","\n","code = app_file.read_text(encoding=\"utf-8\")\n","\n","old_presets = '''PRESETS = {\n","    \"Koblenz · Rhine & Moselle\": (50.3643, 7.6056),\n","    \"Stuttgart · City centre\": (48.7758, 9.1829),\n","    \"Passau · Three rivers\": (48.57356, 13.47636),\n","}'''\n","\n","new_presets = '''PRESETS = {\n","    \"Heidelberg\": (49.3988, 8.6724),\n","    \"Stuttgart\": (48.7758, 9.1829),\n","    \"Mannheim\": (49.4875, 8.4660),\n","    \"Karlsruhe\": (49.0069, 8.4037),\n","    \"Freiburg\": (47.9990, 7.8421),\n","    \"Koblenz\": (50.3643, 7.6056),\n","    \"Ulm\": (48.4011, 9.9876),\n","    \"Tübingen\": (48.5216, 9.0576),\n","    \"Passau\": (48.57356, 13.47636),\n","}'''\n","\n","if code.count(old_presets) == 1:\n","    updated = code.replace(old_presets, new_presets)\n","\n","    # Check syntax before saving\n","    compile(updated, str(app_file), \"exec\")\n","\n","    app_file.write_text(updated, encoding=\"utf-8\")\n","\n","    print(\"City options updated successfully!\")\n","    print(\"Prediction year: 2021\")\n","    print(\"Available cities: 9\")\n","else:\n","    print(\"Original city presets not found. No changes made.\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ysLnO__Town1","executionInfo":{"status":"ok","timestamp":1794183032137,"user_tz":-60,"elapsed":30,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"07cf2deb-8b04-48db-8aec-f821d2d4b586"},"execution_count":30,"outputs":[{"output_type":"stream","name":"stdout","text":["City options updated successfully!\n","Prediction year: 2021\n","Available cities: 9\n"]}]},{"cell_type":"code","source":["\n","# Step 26: Launch the full 2021 dashboard\n","\n","import subprocess\n","import sys\n","import time\n","import requests\n","from pathlib import Path\n","from google.colab import output\n","\n","app_path = \"/content/drive/MyDrive/LULC_Project/app_2021_full.py\"\n","log_path = \"/content/streamlit_full_2021.log\"\n","\n","# Start the full dashboard on port 8502\n","log_file = open(log_path, \"w\")\n","\n","process_full = subprocess.Popen(\n","    [\n","        sys.executable, \"-m\", \"streamlit\", \"run\",\n","        app_path,\n","        \"--server.port=8502\",\n","        \"--server.address=0.0.0.0\",\n","        \"--server.headless=true\",\n","        \"--server.enableCORS=false\",\n","        \"--server.enableXsrfProtection=false\"\n","    ],\n","    stdout=log_file,\n","    stderr=subprocess.STDOUT\n",")\n","\n","time.sleep(5)\n","\n","print(\"Full dashboard running:\", process_full.poll() is None)\n","\n","# Check whether Streamlit is responding\n","try:\n","    response = requests.get(\n","        \"http://127.0.0.1:8502/_stcore/health\",\n","        timeout=10\n","    )\n","\n","    print(\"Server status:\", response.status_code)\n","\n","    if response.status_code == 200:\n","        output.serve_kernel_port_as_window(8502)\n","\n","except Exception as e:\n","    print(\"Startup error:\", e)\n","    print(Path(log_path).read_text()[-3000:])\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"aGTk-UbvpGw-","executionInfo":{"status":"ok","timestamp":1794183097254,"user_tz":-60,"elapsed":5083,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"fda0b44e-0fdc-46fd-a5cf-1af9739f237a"},"execution_count":31,"outputs":[{"output_type":"stream","name":"stdout","text":["Full dashboard running: True\n","Startup error: HTTPConnectionPool(host='127.0.0.1', port=8502): Max retries exceeded with url: /_stcore/health (Caused by NewConnectionError('<urllib3.connection.HTTPConnection object at 0x7c7db7327ac0>: Failed to establish a new connection: [Errno 111] Connection refused'))\n","\n","Collecting usage statistics. To deactivate, set browser.gatherUsageStats to false.\n","\n","\n"]}]},{"cell_type":"code","source":["\n","# Step 26A: Check Streamlit startup and errors\n","\n","import requests\n","import time\n","from pathlib import Path\n","\n","log_path = Path(\"/content/streamlit_full_2021.log\")\n","\n","print(\"Checking full dashboard on port 8502...\")\n","\n","connected = False\n","\n","for attempt in range(1, 11):\n","    try:\n","        response = requests.get(\n","            \"http://127.0.0.1:8502/_stcore/health\",\n","            timeout=3\n","        )\n","\n","        print(\"Server status:\", response.status_code)\n","\n","        if response.status_code == 200:\n","            connected = True\n","            break\n","\n","    except requests.RequestException:\n","        print(f\"Check {attempt}: Server not ready\")\n","\n","    time.sleep(2)\n","\n","print(\"\\nDashboard ready:\", connected)\n","\n","print(\"\\n===== STREAMLIT LOGS =====\")\n","if log_path.exists():\n","    print(log_path.read_text()[-4000:])\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"gOCq_K83pVba","executionInfo":{"status":"ok","timestamp":1794183162901,"user_tz":-60,"elapsed":28,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"0cdeaf4d-ad65-442b-deee-be99d49c5588"},"execution_count":32,"outputs":[{"output_type":"stream","name":"stdout","text":["Checking full dashboard on port 8502...\n","Server status: 200\n","\n","Dashboard ready: True\n","\n","===== STREAMLIT LOGS =====\n","\n","Collecting usage statistics. To deactivate, set browser.gatherUsageStats to false.\n","\n","2026-11-09 00:11:38.786 Uvicorn server started on 0.0.0.0:8502\n","\n","  You can now view your Streamlit app in your browser.\n","\n","  Local URL: http://localhost:8502\n","  Network URL: http://172.28.0.12:8502\n","  External URL: http://34.127.105.151:8502\n","\n","\n"]}]},{"cell_type":"code","source":["\n","# Step 26B: Open the full Streamlit dashboard\n","\n","from google.colab import output\n","\n","print(\"Opening full LULC 2021 Dashboard...\")\n","\n","output.serve_kernel_port_as_window(8502)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":86},"id":"Z3yYVrbJpmsb","executionInfo":{"status":"ok","timestamp":1794183209686,"user_tz":-60,"elapsed":74,"user":{"displayName":"Akash Mamilla","userId":"16167481528311198686"}},"outputId":"7e6fa488-baf1-49c1-fdbc-cb8b96138bad"},"execution_count":33,"outputs":[{"output_type":"stream","name":"stdout","text":["Opening full LULC 2021 Dashboard...\n","\u001b[31mWarning: This function may stop working due to changes in browser security.\n","Try `serve_kernel_port_as_iframe` instead. \u001b[0m\n"]},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["(async (port, path, text, element) => {\n","    if (!google.colab.kernel.accessAllowed) {\n","      return;\n","    }\n","    element.appendChild(document.createTextNode(''));\n","    const url = await google.colab.kernel.proxyPort(port);\n","    const anchor = document.createElement('a');\n","    anchor.href = new URL(path, url).toString();\n","    anchor.target = '_blank';\n","    anchor.setAttribute('data-href', url + path);\n","    anchor.textContent = text;\n","    element.appendChild(anchor);\n","  })(8502, \"/\", \"https://localhost:8502/\", window.element)"]},"metadata":{}}]},{"cell_type":"code","source":["from google.colab import drive\n","\n","drive.mount(\"/content/drive\")\n","\n","from pathlib import Path\n","\n","project = Path(\"/content/drive/MyDrive/LULC_Project\")\n","\n","print(\"Project exists:\", project.exists())\n","